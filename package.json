{
  "name": "agent-arena-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "check": "tsx scripts/harness/run-gates.ts all",
    "check:static": "tsx scripts/harness/run-gates.ts static",
    "check:architecture": "tsx scripts/harness/check-architecture.ts",
    "check:docs": "tsx scripts/harness/check-docs.ts",
    "duplication": "jscpd packages examples scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hygiene": "knip --reporter compact",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:coverage:ci": "vitest run --coverage --config vitest.config.ts --exclude packages/acp-runtime/tests/process.test.ts",
    "prepare": "node scripts/harness/install-hooks.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "jscpd": "5.0.16",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.32.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "lefthook"
    ]
  }
}
